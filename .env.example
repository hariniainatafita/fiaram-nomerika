# Copiez ce fichier en ".env.local" et remplissez avec les valeurs de votre projet Supabase.
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Notifications push (fonction Cloudflare functions/api/push.js) ---
# A definir dans les variables d'environnement Cloudflare Pages, pas ici :
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# FIREBASE_PROJECT_ID=...
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@....iam.gserviceaccount.com
# PUSH_WEBHOOK_SECRET=une-valeur-secrete
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
