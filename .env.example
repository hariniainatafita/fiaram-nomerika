# Copiez ce fichier en ".env.local" et remplissez avec les valeurs de votre projet Supabase.
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optionnel : proxy de bascule multi-cloud pour les données (app_state).
# Les requêtes de données passent alors par /api/db, qui répartit vers les
# projets listés dans SUPABASE_PROJECTS (voir plus bas) et bascule si l'un est
# plein. Auth, Realtime et Storage restent en direct sur VITE_SUPABASE_URL.
# VITE_SUPABASE_PROXY_URL=https://fiaram-nomerika.pages.dev/api/db

# --- Notifications push (fonction Cloudflare functions/api/push.js) ---
# A definir dans les variables d'environnement Cloudflare Pages, pas ici :
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# FIREBASE_PROJECT_ID=...
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@....iam.gserviceaccount.com
# PUSH_WEBHOOK_SECRET=une-valeur-secrete
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Bascule automatique du stockage média (functions/api/upload.js) ---
# Cloudflare Pages > Settings > Functions > R2 bucket bindings :
#   MEDIA   -> bucket principal (ex. fiaram-nomerika-media)
#   MEDIA_2 -> bucket de secours (optionnel, autre compte/compartiment)
#   MEDIA_3 -> second secours (optionnel)
# Puis, dans les variables d'environnement Cloudflare Pages, une liste JSON de
# fournisseurs compatibles S3 (Backblaze B2, Wasabi, IDrive e2...) essayés
# après les buckets R2, dans l'ordre du tableau :
# MEDIA_S3=[{"name":"b2","endpoint":"https://s3.us-west-004.backblazeb2.com","region":"us-west-004","bucket":"fiaram-media","accessKeyId":"...","secretAccessKey":"...","publicUrl":"https://f004.backblazeb2.com/file/fiaram-media"}]
# Chaque fournisseur plein ou en panne est ignoré et le suivant prend le relais.

# --- Proxy de données multi-cloud (functions/api/db/[[path]].js) ---
# Liste JSON des bases, essayées dans l'ordre. Écritures dupliquées sur toutes,
# lectures basculées vers la première disponible. Le client doit pointer
# VITE_SUPABASE_PROXY_URL vers https://<site>/api/db.
# SUPABASE_PROJECTS=["https://xxxx.supabase.co","https://yyyy.supabase.co"]
# ou, si les clés anon diffèrent :
# SUPABASE_PROJECTS=[{"url":"https://xxxx.supabase.co","anonKey":"..."},{"url":"https://yyyy.supabase.co","anonKey":"..."}]
